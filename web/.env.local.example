# Copy to web/.env.local and fill in. NEVER commit .env.local.
# Both values are public (shipped to the browser); data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) from Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Do NOT add the service role / secret key to this static app.

# Optional: public Google OAuth web client ID for the home calendar
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
