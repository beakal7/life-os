# ── Supabase ───────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
#
# Get these from your Supabase project: Settings → API

# Public keys — safe to expose in the browser (NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Server-only secret — NEVER add NEXT_PUBLIC_ prefix here
# Only needed for Phase 3 admin operations (user management, etc.)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ────────────────────────────────────────────────────────────────────────
# Used in auth email redirect URLs (must match Supabase Redirect URLs setting)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Kiro Crew API (Phase 3) ───────────────────────────────────────────────────
# KIRO_CREW_WEBHOOK_SECRET=your-webhook-secret-here
